[Desktop Entry]
Categories={{categories}}
Comment={{comment}}
{{#if mime_type}}MimeType={{mime_type}}{{/if}}
# %U is the whole reason this template exists: the bundler's default entry
# registers the mast:// scheme but launches the app WITHOUT the URL, so
# every installed-build deep link would arrive empty-handed.
Exec={{exec}} %U
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
StartupWMClass={{exec}}
