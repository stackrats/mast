{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mast",
  "version": "0.1.0",
  "identifier": "dev.mast.desktop",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run --filter ./clients/desktop-vue build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mast",
        "width": 1100,
        "height": 720,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Control tower for local Laravel Sail development",
    "linux": {
      "deb": {
        "depends": ["docker-ce | docker.io"]
      }
    }
  }
}
